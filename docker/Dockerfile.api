# api and scheduler: Python 3.12 slim, the llm_url_scan package and its pinned dependencies (pyproject.toml). Build context: the repo root.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
WORKDIR /app
COPY pyproject.toml /app/
COPY llm_url_scan /app/llm_url_scan
RUN pip install --no-cache-dir . && useradd --system --uid 10001 --no-create-home app
USER 10001
CMD ["python", "-m", "llm_url_scan", "serve"]
